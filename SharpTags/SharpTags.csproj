<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>SharpTags</Title>
		<Description>A lightweight and intuitive HTML templating engine.</Description>
		<Version>0.1.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<Authors>Jonathan Nicholl</Authors>
		<Copyright>Copyright © $(Authors) 2026</Copyright>
		<PackageTags>html web templating</PackageTags>

		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<IsPackable>true</IsPackable>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SharpTags.AspNetCore" />
		<InternalsVisibleTo Include="SharpTags.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="../LICENSE" Pack="true" PackagePath="/" />
		<None Include="../LICENSE.LESSER" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
