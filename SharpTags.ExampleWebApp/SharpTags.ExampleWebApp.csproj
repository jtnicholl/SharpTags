<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Title>SharpTags Example Web Application</Title>

		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../SharpTags/SharpTags.csproj" />
		<ProjectReference Include="../SharpTags.AspNetCore/SharpTags.AspNetCore.csproj" />

		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.2.26504.105" />
	</ItemGroup>
</Project>
